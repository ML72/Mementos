# Example environment file. Copy to `.env` to override defaults.
# Everything here is OPTIONAL; the app runs with sensible defaults out of the box.
# Full reference: docs/ENVIRONMENT_OVERVIEW.md

# --- Core ---
# NODE_ENV=development
# PORT=3000
# MONGO_URI=mongodb://127.0.0.1:27017/dev
# JWT_SECRET=change-me-in-production

# --- Email (optional: without SMTP_HOST, every message is printed to the server console) ---
# APP_URL=https://www.example.com                   # origin for links inside emails; set in production
# EMAIL_FROM="Mementos <no-reply@example.com>"      # must be on a domain verified with the provider
# SMTP_HOST=smtp.resend.com                         # any SMTP provider works; these values are Resend's
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=<Resend API key>
# EMAIL_VERIFICATION_REQUIRED=true                  # false lets accounts sign in unverified
# EMAIL_CODE_SECRET=                                # HMAC secret for emailed codes (defaults to JWT_SECRET)
# EMAIL_CODE_IP_MAX_REQUESTS=20                     # per-IP cap on the code endpoints, per 15 minutes

# Example environment file. Copy to `.env` to override defaults.
# Everything here is OPTIONAL; the app runs with sensible defaults out of the box.
# Full reference: docs/ENVIRONMENT_OVERVIEW.md

# --- Core ---
# NODE_ENV=development
# PORT=3000
# MONGO_URI=mongodb://127.0.0.1:27017/dev
# JWT_SECRET=change-me-in-production

# --- Email (optional; without SMTP, messages are printed to the console instead of sent) ---
# Public origin used for links inside emails (open the app, one-click unsubscribe). Set in production.
# APP_URL=https://www.example.com
# Sender address. Use a domain you control, with SPF/DKIM set up, or mail will land in spam.
# EMAIL_FROM="Mementos <no-reply@example.com>"
# SMTP: either a single URL...
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# ...or host/port/credentials.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Force a transport regardless of the above: smtp | console | memory
# EMAIL_TRANSPORT=console
# HMAC secret for password-reset codes. Defaults to JWT_SECRET; set separately if you prefer.
# PASSWORD_RESET_SECRET=
# Per-IP cap on the two public password-reset endpoints (per 15 minutes).
# PASSWORD_RESET_IP_MAX_REQUESTS=20
# Weekly digest schedule (cron expression + IANA timezone), on/off switch, and send throttle.
# DIGEST_ENABLED=true
# DIGEST_CRON="0 9 * * 1"
# DIGEST_TIMEZONE=UTC
# DIGEST_THROTTLE_MS=200
# Shared secret for POST /api/email/events (bounce/complaint webhook). Empty disables the endpoint.
# EMAIL_WEBHOOK_SECRET=

# Example environment file. Copy to `.env` to override defaults.
# Everything here is OPTIONAL; the app runs with sensible defaults out of the box.
# Full reference: docs/ENVIRONMENT_OVERVIEW.md

# --- Core ---
# NODE_ENV=development
# PORT=3000
# MONGO_URI=mongodb://127.0.0.1:27017/dev
# JWT_SECRET=change-me-in-production

# --- Email (optional: with no SMTP settings, every message is printed to the server console) ---
# APP_URL=https://www.example.com                   # origin for links inside emails; set in production
# EMAIL_FROM="Mementos <no-reply@example.com>"      # use a domain you control (SPF/DKIM), or mail lands in spam
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # or SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASS
# EMAIL_TRANSPORT=console                           # force a transport: smtp | console | memory
# PASSWORD_RESET_SECRET=                            # HMAC secret for reset codes (defaults to JWT_SECRET)
# PASSWORD_RESET_IP_MAX_REQUESTS=20                 # per-IP cap on the reset endpoints, per 15 minutes
# DIGEST_ENABLED=true
# DIGEST_CRON="0 9 * * 1"                           # weekly digest schedule, evaluated in DIGEST_TIMEZONE
# DIGEST_TIMEZONE=UTC
# DIGEST_THROTTLE_MS=200                            # pause between recipients
